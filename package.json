{
  "name": "pi-continuity",
  "version": "0.2.0",
  "description": "Dedicated continuity summaries for manual and automatic Pi compaction",
  "private": false,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "continuity",
    "compaction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/pi-continuity.git"
  },
  "bugs": {
    "url": "https://github.com/xz-dev/pi-continuity/issues"
  },
  "homepage": "https://github.com/xz-dev/pi-continuity#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "internal",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest --run",
    "test:e2e:xz-dev-pi": "node scripts/e2e-xz-dev-pi.mjs",
    "test:e2e:upstream-pi": "node scripts/e2e-earendil-works-pi.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.82.0",
    "@earendil-works/pi-coding-agent": ">=0.82.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
